# ═══════════════════════════════════════════
#   Mitsuha ✦ — Discord Music Bot Config
# ═══════════════════════════════════════════

# ── Discord ──────────────────────────────
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# ── Bot ───────────────────────────────────
# Invite link shown in /invite command
INVITE_LINK=https://discord.gg/yourinvite

# ── Binary Paths ─────────────────────────
# Auto-detected based on OS. Override if needed.
# Linux (Pterodactyl / ARM64):
# YTDLP_PATH=./yt-dlp/linux/yt-dlp
# Windows:
# YTDLP_PATH=./yt-dlp/windows/yt-dlp.exe
# FFMPEG_PATH=ffmpeg

# ── yt-dlp Temp Dir ───────────────────────
# Required on Pterodactyl — /tmp is often mounted noexec
# Create dir first: mkdir -p /home/container/tmp
# YTDLP_TMPDIR=/home/container/tmp

# ── Proxy (REQUIRED for datacenter IPs) ───
# ⚠️  YouTube actively blocks datacenter/VPS IP ranges.
#     You MUST route traffic through a residential IP
#     (e.g. WireGuard VPN + WireProxy → SOCKS5 proxy).
#     Without this, you will get 403 errors or no results.
# PROXY_URL=socks5://172.18.0.1:1080
